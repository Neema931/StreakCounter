# StreakCounter Firebase Configuration
# If you have a Firebase project and want live cloud synchronization,
# fill in the credentials below. When these are empty, StreakCounter
# runs in Local / Offline Mode using browser storage.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

